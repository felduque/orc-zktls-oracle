target/
**/target/
.env
# Secrets files contain the raw prover token by design. Never commit them.
spikes/**/fixtures/secrets-*.bin

# Foundry outputs (contracts/). Local anvil broadcasts are throwaway.
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/**/dry-run/
# GitHub's unauthenticated rate-limit 403 embeds the client's public IP in the
# body, and these presentations reveal the full response. Never publish them.
spikes/m0b-mpc-github/fixtures/*-graphql-noauth.bin

# `orc prove --out-dir out/...` (README). A presentation reveals the full GitHub
# response (login, ids, commit count): personal data, never commit it.
/out/
